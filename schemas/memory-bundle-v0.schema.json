{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas:memory-bundle:v0",
  "description": "PUBLIC SYNTHETIC ONLY. Private/person/agent bundles must be separately authorized and scoped, not placed in this open reference schema.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "atlas.memory-bundle/v0"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,80}$"
    },
    "recorded_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "opaque_subject_id"
      ],
      "properties": {
        "kind": {
          "const": "PROJECT_SYNTHETIC"
        },
        "opaque_subject_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "context_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "ontology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "edition",
        "digest_sha256",
        "addresses"
      ],
      "properties": {
        "registry": {
          "const": "ariadne-reader"
        },
        "edition": {
          "const": "v0.7"
        },
        "digest_sha256": {
          "const": "07533cf7a6b6f567259962bf73efee9b22b47cbacb429499787800e07864e5a6"
        },
        "addresses": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^H(0[1-9]|1[0-2])\\.S(0[1-9]|1[0-2])\\.N(0[1-9]|1[0-2])$"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "ref",
          "sha256",
          "scope",
          "source_status",
          "authorship"
        ],
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^synthetic://",
            "maxLength": 200
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "scope": {
            "const": "PUBLIC_SYNTHETIC"
          },
          "source_status": {
            "const": "SOURCE_POINTER_ONLY"
          },
          "authorship": {
            "const": "SELF_DECLARED"
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_class",
        "allowed_purposes",
        "read_grant",
        "return_grant",
        "revocation_epoch",
        "public_release_authorized"
      ],
      "properties": {
        "data_class": {
          "const": "PUBLIC_SYNTHETIC"
        },
        "allowed_purposes": {
          "const": [
            "LOCAL_REPLAY_DEMO"
          ]
        },
        "read_grant": {
          "const": "HOST_NOT_ATTESTED"
        },
        "return_grant": {
          "const": "HOST_NOT_ATTESTED"
        },
        "revocation_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "public_release_authorized": {
          "const": false
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author_claim",
        "source_edition",
        "raw_export_status",
        "observed_revision"
      ],
      "properties": {
        "author_claim": {
          "const": "SELF_DECLARED"
        },
        "source_edition": {
          "type": "string",
          "minLength": 1
        },
        "raw_export_status": {
          "const": "SOURCE_POINTER_ONLY"
        },
        "observed_revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_sha256",
        "fork_status",
        "parent_authority_inherited"
      ],
      "properties": {
        "parent_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        },
        "fork_status": {
          "enum": [
            "ORIGINAL",
            "FORK_PREPARED"
          ]
        },
        "parent_authority_inherited": {
          "const": false
        }
      }
    },
    "rehydration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "identity_claim",
        "uncertainties",
        "human_confirmation_required",
        "private_mode_import"
      ],
      "properties": {
        "contract_id": {
          "const": "atlas.rehydration-contract/v0-demo"
        },
        "identity_claim": {
          "const": "ARCHIVAL_CONTEXT_ONLY"
        },
        "uncertainties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "human_confirmation_required": {
          "const": true
        },
        "private_mode_import": {
          "const": false
        }
      }
    },
    "status": {
      "const": "CANDIDATE_NOT_CANON"
    }
  },
  "required": [
    "schema_version",
    "bundle_id",
    "recorded_at",
    "subject",
    "context_summary",
    "ontology",
    "sources",
    "permissions",
    "provenance",
    "fork",
    "rehydration",
    "status"
  ],
  "additionalProperties": false
}