{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas:noosphere:evidence-packet:0.1.0",
  "title": "Noosphere public evidence candidate packet, v0.1",
  "description": "Structural candidate-only contract. A valid packet does NOT establish factual truth, identity, copyright clearance, CANON, deployment, or source ownership.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_mode",
    "raw_export_status",
    "source_roots",
    "preserved",
    "completeness_claim",
    "lifecycle",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "source_mode": {
      "enum": [
        "public",
        "consented_work",
        "synthetic"
      ],
      "description": "Declared origin only; external authorization and provenance must also be checked. No automatic Play/Imagine intake."
    },
    "raw_export_status": {
      "enum": [
        "raw_missing",
        "raw_partial",
        "raw_complete_unhashed",
        "raw_complete_hashed",
        "raw_source_unavailable"
      ]
    },
    "source_roots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface",
          "root_ref"
        ],
        "properties": {
          "surface": {
            "enum": [
              "repository",
              "drive",
              "notion",
              "web",
              "synthetic",
              "other"
            ]
          },
          "root_ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "export_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preserved": {
      "const": true
    },
    "completeness_claim": {
      "type": "boolean"
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "flags",
        "authority",
        "canon",
        "deployed"
      ],
      "properties": {
        "stage": {
          "enum": [
            "RAW",
            "PARSED",
            "CLAIM",
            "CANDIDATE",
            "REVIEWED",
            "RATIFIED"
          ]
        },
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "CONTRADICTED",
              "SUPERSEDED",
              "QUARANTINED"
            ]
          }
        },
        "authority": {
          "const": "none"
        },
        "canon": {
          "const": false
        },
        "deployed": {
          "const": false
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,120}$"
          },
          "type": {
            "enum": [
              "SourceSurface",
              "RawExportManifest",
              "Artifact",
              "Claim",
              "Evidence",
              "Contradiction",
              "Delta",
              "ReviewLane",
              "CanonGate",
              "ActionPacket",
              "Receipt",
              "Supersession"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "type"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "derived_from",
              "claims",
              "supports",
              "contradicts",
              "supersedes",
              "reviewed_by",
              "gated_by",
              "implemented_as",
              "preserved_as",
              "quarantined_as"
            ]
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "completeness_claim": {
            "const": true
          }
        },
        "required": [
          "completeness_claim"
        ]
      },
      "then": {
        "properties": {
          "raw_export_status": {
            "const": "raw_complete_hashed"
          }
        },
        "required": [
          "export_receipt_sha256"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "raw_export_status": {
            "const": "raw_complete_hashed"
          }
        },
        "required": [
          "raw_export_status"
        ]
      },
      "then": {
        "required": [
          "export_receipt_sha256"
        ],
        "properties": {
          "source_roots": {
            "minItems": 1,
            "items": {
              "required": [
                "sha256"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "raw_export_status": {
            "enum": [
              "raw_missing",
              "raw_partial",
              "raw_complete_unhashed",
              "raw_source_unavailable"
            ]
          }
        },
        "required": [
          "raw_export_status"
        ]
      },
      "then": {
        "properties": {
          "completeness_claim": {
            "const": false
          }
        }
      }
    }
  ]
}
